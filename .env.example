# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only Supabase secret (never NEXT_PUBLIC)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Tavily production API
TAVILY_API_KEY=tvly_xxx

# Provider-neutral OpenAI-compatible model endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
LLM_EMBEDDING_MODEL=replace_me

# Aveiro distribution adapter
AVEIRO_API_BASE_URL=https://www.aveiro.app/api/v1
AVEIRO_API_TOKEN=av_live_xxx
AVEIRO_SITE_ID=replace_me

# Cron/internal worker authentication
CRON_SECRET=replace_with_long_random_value
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=NewsOS

# Optional provider pricing for accurate spend estimates/budget enforcement.
# Set these to the CURRENT prices from your provider account; NewsOS does not invent defaults.
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
LLM_EMBEDDING_COST_PER_1M_USD=
TAVILY_SEARCH_COST_USD=
TAVILY_EXTRACT_COST_USD=
TAVILY_CRAWL_COST_USD=
TAVILY_RESEARCH_COST_USD=
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
